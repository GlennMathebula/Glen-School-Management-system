{
  "name": "glen-moniques-staff-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Glen Moniques Staff Desktop App",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 5176",
    "dev:desktop": "wait-on http://127.0.0.1:5176 && electron . --dev",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:desktop\"",
    "build": "vite build",
    "desktop": "npm run build && electron ."
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "vite": "^8.3.1",
    "wait-on": "^9.5.1"
  }
}
